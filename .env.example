# Optional Docker Compose settings. Copy this file to .env to customize.
SPR_PORT=8000
SPR_BIND_ADDRESS=127.0.0.1
SPR_PUBLIC_BASE_URL=http://localhost:8000

# Host directory containing RUN-20260827-0001/manifest.json.
# Use forward slashes for Windows paths, e.g. C:/Users/User/data.
SPR_DATA_DIR=./data

SPR_WORKERS=10
SPR_DUCKDB_THREADS=2
SPR_JOB_TIMEOUT=600

# Used only when accounts are first created in an empty Docker volume.
SPR_DEMO_PASSWORD=demo
